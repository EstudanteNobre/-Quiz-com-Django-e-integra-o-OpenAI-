# =============================================
# CONFIGURAÇÕES DA OPENAI - INFO QUIZ
# =============================================
# 
# INSTRUÇÕES:
# 1. Copie este arquivo e renomeie para ".env"
# 2. Substitua "sua_chave_api_aqui" pela sua chave de API da OpenAI
# 3. Obtenha sua chave em: https://platform.openai.com/api-keys
#
# =============================================

SECRET_KEY=sua_secret_key_aqui

# Chave da API da OpenAI (OBRIGATÓRIO)
OPENAI_API_KEY=sua_chave_api_aqui

# Modelo da OpenAI (recomendado: gpt-4o-mini para custo-benefício)
# Opções: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

DEBUG=True

